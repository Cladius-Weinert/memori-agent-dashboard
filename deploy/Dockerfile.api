FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-client ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/api/pyproject.toml .
RUN pip install --no-cache-dir \
    fastapi "uvicorn[standard]" asyncssh "sqlalchemy[asyncio]" asyncpg \
    alembic pydantic pydantic-settings "python-jose[cryptography]" \
    "passlib[bcrypt]" "bcrypt==4.0.1" redis celery httpx boto3 websockets openai \
    langgraph python-multipart email-validator psutil

COPY apps/api/app /app/app
COPY apps/api/alembic.ini /app/alembic.ini
COPY apps/api/alembic /app/alembic

EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head 2>/dev/null; exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
