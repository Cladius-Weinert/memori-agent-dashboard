# Shared env vars for docker-compose / Fly / Railway / Render
# Default: Docker service name. If API cannot reach db:5432 (some cloud VMs), use:
# DATABASE_URL=postgresql+asyncpg://memori:memori@host.docker.internal:5433/memori?ssl=disable
DATABASE_URL=postgresql+asyncpg://memori:memori@db:5432/memori?ssl=disable
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-production-please-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LLM_API_KEY=your-nvidia-api-key
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
WORKSPACE_ROOT=/workspace
WORKSPACE_HOST_PATH=..
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://web:3000,http://localhost:3002
NEXT_PUBLIC_API_URL=
VAULT_ADDR=