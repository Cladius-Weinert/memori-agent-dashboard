# Opsora Agent — Supabase Production Config
# Copy DB password from: Supabase Dashboard → opsora-prod → Settings → Database → Connection string (URI)

SUPABASE_PROJECT_REF=mwbgkkthwwlcndccnbnf
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
SUPABASE_POOLER_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_SCHEMA=agent

# Or set full URL directly (pooler = IPv4, direct db.* host = IPv6 only):
# DATABASE_URL=postgresql+asyncpg://postgres.mwbgkkthwwlcndccnbnf:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?ssl=require

REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-production-please-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

LLM_API_KEY=your-nvidia-api-key
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

WORKSPACE_ROOT=/workspace
WORKSPACE_HOST_PATH=..
CORS_ORIGINS=http://localhost:3002,https://dash.98-94-100-100.sslip.io,https://agent.98-94-100-100.sslip.io,http://98.94.100.100:3002
NEXT_PUBLIC_API_URL=
VAULT_ADDR=

