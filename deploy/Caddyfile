# Opsora Agent Dashboard — Caddy reverse proxy
# Production: opsora.com (auto-HTTPS via Let's Encrypt)
# Dev/staging: :80 (no TLS)

# Staging / IP access
:80 {
	reverse_proxy /api/* localhost:8000
	reverse_proxy /docs localhost:8000
	reverse_proxy /openapi.json localhost:8000
	reverse_proxy /ws/* localhost:8000
	reverse_proxy localhost:3000

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	encode gzip
}

# Production domain (uncomment when DNS is pointed)
