# Memori Agent & Dashboard - Backend Envs
DATABASE_URL=postgresql+asyncpg://memori:memori@localhost:5432/memori
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production-please-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LLM_API_KEY=your-nvidia-api-key
# NVIDIA Integrate (default) or set NVIDIA_MODE=nvcf for hosted GPU functions
LLM_MODEL=meta/llama-3.1-70b-instruct
# LLM_MODEL=ai-mistral-small-4-119b-2603
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
WORKSPACE_ROOT=/path/to/your/project
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VAULT_ADDR=
